def main(argv):
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding='utf-8', errors='replace')
        except AttributeError:
            pass
    if len(argv) >= 2 and argv[0] == '--hook':
        return run_hook(argv[1], argv[2:])
    head = argv[0] if argv else ''
    rest = argv[1:]
    if not argv or head == 'status':
        return cmd_status()
    if head in ('-h', '--help', 'help'):
        print(__doc__.strip().split('\n\nVersion')[0])
        return 0
    if head in ('-v', '--version'):
        print(f'gamify {VERSION}')
        return 0
    commands = {
        '--refresh': lambda: cmd_refresh(), '--recap': cmd_recap, '--line': cmd_line, '--json': cmd_json, 'shop': cmd_shop,
        'score': cmd_score,
        'resume': cmd_resume, '-e': cmd_edit, '--edit': cmd_edit,
        'log': lambda: cmd_log(rest), 'redeem': lambda: cmd_redeem(rest), 'pause': lambda: cmd_pause(rest),
    }
    if head not in commands:
        sys.stderr.write(f'gamify: unknown command: {head} (try gamify -h)\n')
        return 2
    return commands[head]()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
