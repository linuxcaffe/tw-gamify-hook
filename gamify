BOXES = {
    'double': '╔═╗║╚╝╟─╢',
    'single': '┌─┐│└┘├─┤',
    'ascii': '+-+|+++-+',
}


def width(text):
    """Terminal cells a string takes (wide emoji are two, variation selectors none)."""
    import re
    import unicodedata
    cells = 0
    for ch in re.sub(r'\x1b\[[0-9;]*m', '', text):
        if unicodedata.combining(ch) or ch in ('️', '‍'):
            continue
        cells += 2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1
    return cells


def fit(text, cells):
    """Text cut to fit in that many terminal cells."""
    if width(text) <= cells:
        return text
    out = ''
    for ch in text:
        if width(out + ch) > cells - 1:
            break
        out += ch
    return out + '…'


def bar(value, low, high, cells=20):
    if high is None or high <= low:
        return '▓' * cells
    filled = max(0, min(cells, int((value - low) / (high - low) * cells)))
    return '▓' * filled + '░' * (cells - filled)


def tally(entries, day):
    groups = {'done': 0, 'tidy': 0, 'rot': 0, 'waltz': 0, 'net': 0}
    for e in entries:
        if e.get('day') != day:
            continue
        coins = e.get('c', 0)
        groups['net'] += coins
        kind = e['k']
        if kind in ('done', 'log'):
            groups['done'] += coins
        elif kind in ('add', 'file', 'genesis') or (kind == 'delete' and coins > 0):
            groups['tidy'] += coins
        elif kind == 'push' or kind == 'delete':
            groups['waltz'] += coins
        elif kind in SWEEP_KINDS:
            groups['rot' if coins < 0 else 'tidy'] += coins
    return groups


def live_counts(cfg, state):
    """Rotting, fossils and zombies right now, or None if task can't say."""
    tasks = export('status:pending')
    if tasks is None:
        return None
    now = datetime.now().astimezone()
    skip = cfg.skip_tags()
    rotting = fossils = zombies = 0
    for t in tasks:
        if set(t.get('tags', ())) & skip:
            continue
        due, started = parse_ts(t.get('due')), parse_ts(t.get('start'))
        touched = parse_ts(t.get('modified')) or parse_ts(t.get('entry'))
        ahead = any(x and x > now for x in map(parse_ts, (t.get('due'), t.get('scheduled'), t.get('wait'))))
        rotting += bool(due and due < now)
        zombies += bool(started and started.date() < now.date())
        fossils += bool(touched and not ahead and (now - touched).days >= cfg.int('fossil-days'))
    return rotting, fossils, zombies


def summary(cfg):
    state = State(read_ledger(), cfg)
    level, title, low, high = state.rank()
    now = today().isoformat()
    yesterday = (today() - timedelta(days=1)).isoformat()
    prizes = cfg.prizes()
    return {
        'state': state, 'level': level, 'rank': title, 'low': low, 'next': high, 'xp': state.xp,
        'coins': state.coins, 'streak': state.streak, 'best': state.best,
        'today': tally(state.live, now), 'yesterday': tally(state.live, yesterday),
        'paused': state.paused_on(now),
        'affordable': sorted((k for k, (cost, _) in prizes.items() if cost <= state.coins and state.coins >= 0),
                             key=lambda k: prizes[k][0]),
        'prizes': prizes,
    }


