BANNER = (' ▀█▀ █ █ █▀▀   █▀▀ █▀█ █▀▄▀█ █▀▀',
          '  █  █▀█ ██▄   █▄█ █▀█ █ ▀ █ ██▄')


def spark(values):
    """(glyph, value) for each day: taller is better."""
    ticks = '▁▂▃▄▅▆▇█'
    low, high = min(values), max(values)
    span = (high - low) or 1
    return [(ticks[int((v - low) / span * (len(ticks) - 1))], v) for v in values]


def wrap_items(items, room, gap='   '):
    rows, current = [], ''
    for item in items:
        joined = current + gap + item if current else item
        if current and width(joined) > room:
            rows.append(current)
            current = item
        else:
            current = joined
    return rows + ([current] if current else [])


def trophy_counts(state):
    counts = dict.fromkeys(('regicide', 'moon', 'clean', 'early', 'focus', 'done', 'verylate', 'mercy', 'prize'), 0)
    pushes = {}
    balance = lowest = 0
    for e in state.live:
        balance += e.get('c', 0)
        lowest = min(lowest, balance)
        kind, why = e['k'], e.get('why', '').split('+')
        if kind == 'done':
            counts['done'] += 1
            for mark in ('regicide', 'moon', 'focus'):
                counts[mark] += mark in why
            counts['early'] += 'early' in why
            counts['verylate'] += 'verylate' in why
        elif kind == 'clean':
            counts['clean'] += 1
        elif kind == 'prize':
            counts['prize'] += 1
        elif kind == 'delete':
            counts['mercy'] += 'mercy' in why
        elif kind == 'push':
            pushes[e.get('u')] = pushes.get(e.get('u'), 0) + 1
    counts['streak'] = state.best
    counts['pushes'] = max(pushes.values(), default=0)
    counts['debt'] = -lowest
    return counts


def trophies(state, cfg):
    """(what you've won, as labels; the one you're nearest, as (label, how far), or None)."""
    counts = trophy_counts(state)
    won, nearest, nearest_share = [], None, -1
    for key, label, metric, need, repeats in TROPHIES:
        try:
            need = int(cfg.raw.get(f'trophy.{key}.need', need))
        except ValueError:
            pass
        label = cfg.raw.get(f'trophy.{key}.label', label)
        if need <= 0:
            continue
        have = counts.get(metric, 0)
        if have >= need:
            won.append(f'{label} ×{have}' if repeats and have > 1 else label)
        elif metric != 'debt' and have / need > nearest_share:
            nearest, nearest_share = (label, need - have), have / need
    return won, nearest


def most_wanted(tasks, state, cfg):
    """The worst offenders, with the charge against each: [(icon, id, description, charge)]."""
    now = datetime.now().astimezone()
    skip = cfg.skip_tags()
    suspects = []
    for t in tasks:
        if set(t.get('tags', ())) & skip:
            continue
        uuid = t['uuid']
        due = parse_ts(t.get('due'))
        touched = parse_ts(t.get('modified')) or parse_ts(t.get('entry'))
        future = any(x and x > now for x in map(parse_ts, (t.get('due'), t.get('scheduled'), t.get('wait'))))
        pushes = state.count_for('push', uuid)
        cost = -sum(e.get('c', 0) for e in state.live if e.get('u') == uuid and e['k'] == 'rot')
        charges = []
        if due and due < now:
            late = (now.date() - due.date()).days
            so_far = f', −{cost} so far' if cost else ''
            when = f"{late} day{'s' if late != 1 else ''} late" if late else 'late today'
            charges.append((late * 3 + 1, '🍂', f'{when}{so_far}'))
        if pushes >= 2:
            charges.append((pushes * 10, '💃', f'pushed {pushes} times'))
        days = (now.date() - touched.date()).days if touched else 0
        if not future and days >= cfg.int('fossil-days'):
            charges.append((days / 10, '🦕', f'{days} days untouched'))
        if charges:
            weight, icon, charge = max(charges, key=lambda c: c[0])
            suspects.append((weight, icon, t.get('id', 0), t.get('description', ''), charge))
    suspects.sort(key=lambda s: -s[0])
    return [s[1:] for s in suspects[:cfg.int('most-wanted')]]


